<?xml version="1.0" encoding="utf-8"?>
<Patch>
  <!-- Current CE Core spear attacks; banner adds mass/bulk, not magical combat bonuses. -->
  <Operation Class="PatchOperationReplace">
    <xpath>Defs/ThingDef[defName="ARIOIAF_WesterosBannerSpear"]/tools</xpath>
    <value><tools>
      <li Class="CombatExtended.ToolCE">
        <label>shaft</label><capacities><li>Blunt</li></capacities>
        <power>7</power><cooldownTime>1.35</cooldownTime><chanceFactor>0.15</chanceFactor>
        <armorPenetrationBlunt>2.25</armorPenetrationBlunt><linkedBodyPartsGroup>Shaft</linkedBodyPartsGroup>
      </li>
      <li Class="CombatExtended.ToolCE">
        <label>shaft</label><capacities><li>Poke</li></capacities>
        <power>4</power><cooldownTime>1.78</cooldownTime><chanceFactor>0.05</chanceFactor>
        <armorPenetrationBlunt>1</armorPenetrationBlunt><linkedBodyPartsGroup>Point</linkedBodyPartsGroup>
      </li>
      <li Class="CombatExtended.ToolCE">
        <label>head</label><capacities><li>Stab</li></capacities>
        <power>18</power><cooldownTime>1.19</cooldownTime>
        <armorPenetrationBlunt>2.25</armorPenetrationBlunt><armorPenetrationSharp>2.25</armorPenetrationSharp>
        <linkedBodyPartsGroup>Head</linkedBodyPartsGroup>
      </li>
    </tools></value>
  </Operation>
  <Operation Class="PatchOperationAdd">
    <xpath>Defs/ThingDef[defName="ARIOIAF_WesterosBannerSpear"]/statBases</xpath>
    <value><Bulk>12</Bulk><MeleeCounterParryBonus>1.68</MeleeCounterParryBonus></value>
  </Operation>
  <Operation Class="PatchOperationAdd">
    <xpath>Defs/ThingDef[defName="ARIOIAF_WesterosBannerSpear"]</xpath>
    <value><equippedStatOffsets><MeleeCritChance>0.17</MeleeCritChance><MeleeParryChance>1.45</MeleeParryChance><MeleeDodgeChance>0.9</MeleeDodgeChance></equippedStatOffsets></value>
  </Operation>
</Patch>
