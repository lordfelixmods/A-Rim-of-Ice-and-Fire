<?xml version="1.0" encoding="utf-8"?>
<Patch>
  <!-- Optional cloth clothing conversion, matching this mod's CE tunic material scale.
       No armor-class, loadout, layer, recipe, renderer or existing-belt changes. -->
  <Operation Class="PatchOperationReplace">
    <xpath>/Defs/ThingDef[defName="ARIOIAF_WesterosTabard"]/statBases/StuffEffectMultiplierArmor</xpath>
    <value><StuffEffectMultiplierArmor>3</StuffEffectMultiplierArmor></value>
  </Operation>
  <Operation Class="PatchOperationAdd">
    <xpath>/Defs/ThingDef[defName="ARIOIAF_WesterosTabard"]/statBases</xpath>
    <value><Bulk>3</Bulk><WornBulk>0.5</WornBulk></value>
  </Operation>
</Patch>
