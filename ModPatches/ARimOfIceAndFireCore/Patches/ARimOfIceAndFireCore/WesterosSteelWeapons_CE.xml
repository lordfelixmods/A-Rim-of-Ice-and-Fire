    </tools></value>
  </Operation>
  <Operation Class="PatchOperationAdd"><xpath>Defs/ThingDef[defName="ARIOIAF_SoldiersShortSword"]/statBases</xpath><value><Bulk>3</Bulk><MeleeCounterParryBonus>0.3</MeleeCounterParryBonus></value></Operation>
