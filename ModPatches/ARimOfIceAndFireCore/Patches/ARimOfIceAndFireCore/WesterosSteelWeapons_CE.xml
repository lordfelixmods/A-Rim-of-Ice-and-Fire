    <xpath>Defs/ThingDef[defName="ARIOIAF_SoldiersShortSword"]/tools</xpath>
    <value><tools>
      <li Class="CombatExtended.ToolCE"><label>handle</label><capacities><li>Poke</li></capacities><power>2</power><chanceFactor>0.33</chanceFactor><cooldownTime>1.38</cooldownTime><armorPenetrationBlunt>0.4</armorPenetrationBlunt><linkedBodyPartsGroup>Handle</linkedBodyPartsGroup></li>
