      <defaultProjectile>Projectile_CrossbowBolt_Steel</defaultProjectile><warmupTime>0.9</warmupTime><range>21</range><soundCast>Shot_CE_Crossbow</soundCast>
    </Properties>
    <AmmoUser><magazineSize>1</magazineSize><reloadTime>2.8</reloadTime><ammoSet>AmmoSet_CrossbowBolt</ammoSet><AmmoGenPerMagOverride>4</AmmoGenPerMagOverride></AmmoUser>
    <FireModes><aiAimMode>AimedShot</aiAimMode></FireModes>
    <weaponTags><li>CE_XBow</li></weaponTags>
  </Operation>

