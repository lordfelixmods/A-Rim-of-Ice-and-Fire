<?xml version="1.0" encoding="utf-8"?>
<Patch>
  <Operation Class="PatchOperationReplace">
    <xpath>Defs/ThingDef[@Name="ARIOIAF_WesterosCrossbowBase"]/tools</xpath>
    <value><tools><li Class="CombatExtended.ToolCE">
      <label>stock</label><capacities><li>Blunt</li></capacities>
      <power>7</power><cooldownTime>1.6</cooldownTime><armorPenetrationBlunt>0.65</armorPenetrationBlunt><linkedBodyPartsGroup>Stock</linkedBodyPartsGroup>
    </li></tools></value>
