<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- Appointment-only: this trait is forced on the single Citadel candidate and never
       enters ordinary random generation. Skill gains are applied by pawn generation. -->
  <TraitDef>
    <defName>ARIOIAF_CitadelTrained</defName>
    <commonality>0</commonality>
    <degreeDatas>
      <li>
        <label>Citadel-trained</label>
        <description>{PAWN_nameDef} forged a chain at the Citadel and was trained to serve a noble household as healer, scholar, counsellor and keeper of ravens.</description>
        <skillGains>
          <Medicine>4</Medicine>
          <Intellectual>4</Intellectual>
          <Social>2</Social>
        </skillGains>
        <statOffsets>
          <MedicalTendQuality>0.15</MedicalTendQuality>
          <MedicalTendSpeed>0.25</MedicalTendSpeed>
          <ResearchSpeed>0.20</ResearchSpeed>
        </statOffsets>
      </li>
    </degreeDatas>
  </TraitDef>

</Defs>
