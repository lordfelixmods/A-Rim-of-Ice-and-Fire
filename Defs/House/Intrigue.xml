<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- A fictional Westerosi tincture. It sickens for a few days and then fades on its
       own: it is never a scripted execution and carries no lethal severity. -->
  <HediffDef>
    <defName>ARIOIAF_WesterosiTincture</defName>
    <label>tincture sickness</label>
    <description>A dose of some maester's tincture, slipped into food or wine. The victim is weak and feverish for several days, then recovers.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <defaultLabelColor>(0.55, 0.75, 0.45)</defaultLabelColor>
    <scenarioCanAdd>false</scenarioCanAdd>
    <makesSickThought>true</makesSickThought>
    <initialSeverity>0.90</initialSeverity>
    <maxSeverity>1.0</maxSeverity>
    <comps>
      <li Class="HediffCompProperties_SeverityPerDay">
        <severityPerDay>-0.18</severityPerDay>
      </li>
    </comps>
    <stages>
      <li>
        <label>fading</label>
        <minSeverity>0</minSeverity>
        <painOffset>0.10</painOffset>
        <capMods>
          <li>
            <capacity>Consciousness</capacity>
            <offset>-0.10</offset>
          </li>
          <li>
            <capacity>Manipulation</capacity>
            <offset>-0.10</offset>
          </li>
        </capMods>
      </li>
      <li>
        <label>severe</label>
        <minSeverity>0.45</minSeverity>
        <painOffset>0.25</painOffset>
        <capMods>
          <li>
            <capacity>Consciousness</capacity>
            <offset>-0.30</offset>
          </li>
          <li>
            <capacity>Manipulation</capacity>
            <offset>-0.25</offset>
          </li>
          <li>
            <capacity>Moving</capacity>
            <offset>-0.20</offset>
          </li>
        </capMods>
      </li>
    </stages>
  </HediffDef>

  <!-- The friendship is personal and non-romantic. It affects only the two House
       Heads' social opinion and naturally fades with the matching diplomatic bonus. -->
  <ThoughtDef>
    <defName>ARIOIAF_BefriendedHouseHead</defName>
    <thoughtClass>Thought_MemorySocial</thoughtClass>
    <durationDays>30</durationDays>
    <stackLimit>2</stackLimit>
    <stackLimitForSameOtherPawn>1</stackLimitForSameOtherPawn>
    <stages>
      <li>
        <label>befriended a House Head</label>
        <baseOpinionOffset>15</baseOpinionOffset>
      </li>
    </stages>
  </ThoughtDef>

</Defs>
