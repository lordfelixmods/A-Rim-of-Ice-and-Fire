<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <FactionDef ParentName="FactionBase">
    <defName>ARIOIAF_Valyria</defName>
    <label>Valyria</label>
    <description>Dragon-bannered houses of Valyria. Their Blood of the Dragon tradition allows adult relatives to take each other as partners. Warriors wear black beneath scale and Valyrian armor; rulers wear Valyrian-steel Dragonrider plate and dragon helms. Starts at peace. With Royalty, service earns six ranks from Squire to Lord Paramount.</description>
    <fixedName>Valyria</fixedName>
    <pawnSingular>Valyrian</pawnSingular>
    <pawnsPlural>Valyrians</pawnsPlural>
    <categoryTag>ARIOIAF_Valyria</categoryTag>
    <techLevel>Medieval</techLevel>
    <basicMemberKind>ARIOIAF_Valyria_Levy</basicMemberKind>
    <settlementGenerationWeight>1</settlementGenerationWeight>
    <requiredCountAtGameStart>1</requiredCountAtGameStart>
    <maxConfigurableAtWorldCreation>1</maxConfigurableAtWorldCreation>
    <configurationListOrderPriority>75</configurationListOrderPriority>
    <canSiege>false</canSiege>
    <canStageAttacks>true</canStageAttacks>
    <leaderTitle>Lord Paramount</leaderTitle>
    <leaderTitleFemale>Lady Paramount</leaderTitleFemale>
    <leaderForceGenerateNewPawn>true</leaderForceGenerateNewPawn>
    <fixedLeaderKinds><li>ARIOIAF_Valyria_LordParamount</li></fixedLeaderKinds>
    <factionIconPath>UI/Factions/Valyria</factionIconPath>
    <settlementTexturePath>World/WorldObjects/DefaultSettlement</settlementTexturePath>
    <settlementNameMaker>NamerSettlementTribal</settlementNameMaker>
    <colorSpectrum><li>(0.55,0.10,0.12)</li></colorSpectrum>
    <allowedArrivalTemperatureRange>-25~45</allowedArrivalTemperatureRange>
    <backstoryFilters><li><categories><li>Tribal</li></categories></li></backstoryFilters>
    <apparelStuffFilter><thingDefs><li>Cloth</li><li>WoolSheep</li><li>Leather_Plain</li><li>Leather_Heavy</li><li>Steel</li></thingDefs></apparelStuffFilter>
    <allowedCultures><li>Rustican</li></allowedCultures>
    <requiredMemes>
      <li MayRequire="Ludeon.RimWorld.Ideology">ARIOIAF_Structure_FaithOfTheSeven</li>
      <li MayRequire="Ludeon.RimWorld.Ideology">ARIOIAF_ChivalricHonor</li>
      <li MayRequire="Ludeon.RimWorld.Ideology">ARIOIAF_Feudalism</li>
      <li MayRequire="Ludeon.RimWorld.Ideology">ARIOIAF_BloodOfTheDragon</li>
    </requiredMemes>
    <allowedMemes>
      <li MayRequire="Ludeon.RimWorld.Ideology">ARIOIAF_Structure_FaithOfTheSeven</li>
      <li MayRequire="Ludeon.RimWorld.Ideology">ARIOIAF_ChivalricHonor</li>
      <li MayRequire="Ludeon.RimWorld.Ideology">ARIOIAF_Feudalism</li>
      <li MayRequire="Ludeon.RimWorld.Ideology">ARIOIAF_BloodOfTheDragon</li>
    </allowedMemes>
    <structureMemeWeights><ARIOIAF_Structure_FaithOfTheSeven MayRequire="Ludeon.RimWorld.Ideology">1</ARIOIAF_Structure_FaithOfTheSeven></structureMemeWeights>
    <royalFavorLabel MayRequire="Ludeon.RimWorld.Royalty">honor</royalFavorLabel>
    <royalFavorIconPath MayRequire="Ludeon.RimWorld.Royalty">UI/Icons/RoyalFavor</royalFavorIconPath>
    <royalTitleTags MayRequire="Ludeon.RimWorld.Royalty"><li>ARIOIAF_ValyrianTitle</li></royalTitleTags>
    <royalTitleInheritanceWorkerClass MayRequire="Ludeon.RimWorld.Royalty">RoyalTitleInheritanceWorker</royalTitleInheritanceWorkerClass>
    <royalTitleInheritanceRelations MayRequire="Ludeon.RimWorld.Royalty"><li>Child</li><li>Grandchild</li><li>Spouse</li><li>Sibling</li><li>Parent</li></royalTitleInheritanceRelations>
    <caravanTraderKinds><li>Caravan_Neolithic_BulkGoods</li><li>Caravan_Neolithic_WarMerchant</li></caravanTraderKinds>
    <visitorTraderKinds><li>Visitor_Neolithic_Standard</li></visitorTraderKinds>
    <baseTraderKinds><li>Base_Neolithic_Standard</li></baseTraderKinds>
    <maxPawnCostPerTotalPointsCurve><points><li>(0,100)</li><li>(200,150)</li><li>(450,190)</li><li>(800,270)</li><li>(2000,10000)</li></points></maxPawnCostPerTotalPointsCurve>
    <pawnGroupMakers>
      <li><kindDef>Combat</kindDef><options><ARIOIAF_Valyria_Levy>4</ARIOIAF_Valyria_Levy><ARIOIAF_Valyria_Bowman>4</ARIOIAF_Valyria_Bowman><ARIOIAF_Valyria_Footman>6</ARIOIAF_Valyria_Footman><ARIOIAF_Valyria_Houseguard>2</ARIOIAF_Valyria_Houseguard><ARIOIAF_Valyria_Officer>1</ARIOIAF_Valyria_Officer></options></li>
      <li><kindDef>Peaceful</kindDef><options><ARIOIAF_Valyria_Levy>5</ARIOIAF_Valyria_Levy><ARIOIAF_Valyria_Bowman>3</ARIOIAF_Valyria_Bowman><ARIOIAF_Valyria_Officer>1</ARIOIAF_Valyria_Officer></options></li>
      <li><kindDef>Trader</kindDef><traders><ARIOIAF_Valyria_CaravanLeader>1</ARIOIAF_Valyria_CaravanLeader></traders><carriers><Muffalo>5</Muffalo><Alpaca>5</Alpaca></carriers><guards><ARIOIAF_Valyria_Bowman>4</ARIOIAF_Valyria_Bowman><ARIOIAF_Valyria_Footman>6</ARIOIAF_Valyria_Footman><ARIOIAF_Valyria_Houseguard>2</ARIOIAF_Valyria_Houseguard><ARIOIAF_Valyria_Officer>1</ARIOIAF_Valyria_Officer></guards></li>
      <li><kindDef>Settlement</kindDef><options><ARIOIAF_Valyria_Levy>3</ARIOIAF_Valyria_Levy><ARIOIAF_Valyria_Bowman>4</ARIOIAF_Valyria_Bowman><ARIOIAF_Valyria_Footman>6</ARIOIAF_Valyria_Footman><ARIOIAF_Valyria_Houseguard>3</ARIOIAF_Valyria_Houseguard><ARIOIAF_Valyria_Officer>1</ARIOIAF_Valyria_Officer></options></li>
    </pawnGroupMakers>
  </FactionDef>
</Defs>
