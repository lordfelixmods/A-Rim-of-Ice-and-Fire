<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <FactionDef ParentName="FactionBase">
    <defName>ARIOIAF_Westerlanders</defName>
    <label>Westerlanders</label>
    <description>Rich houses of the Westerlands, sworn to the Faith of the Seven and a strict order of service. Red levies, disciplined infantry and crimson-and-gold guards. Starts at peace and sends merchant caravans. With Royalty, service earns titles from Squire to Warden of the West.</description>
    <fixedName>Westerlanders</fixedName>
    <pawnSingular>westerlander</pawnSingular>
    <pawnsPlural>westerlanders</pawnsPlural>
    <categoryTag>ARIOIAF_Westerlanders</categoryTag>
    <techLevel>Medieval</techLevel>
    <basicMemberKind>ARIOIAF_Westerlanders_Levy</basicMemberKind>
    <settlementGenerationWeight>1</settlementGenerationWeight>
    <requiredCountAtGameStart>1</requiredCountAtGameStart>
    <maxConfigurableAtWorldCreation>1</maxConfigurableAtWorldCreation>
    <configurationListOrderPriority>76</configurationListOrderPriority>
    <canSiege>false</canSiege>
    <canStageAttacks>true</canStageAttacks>
    <leaderTitle>Warden of the West</leaderTitle>
    <leaderForceGenerateNewPawn>true</leaderForceGenerateNewPawn>
    <fixedLeaderKinds><li>ARIOIAF_Westerlanders_Warden</li></fixedLeaderKinds>
    <factionIconPath>UI/Factions/Westerlanders</factionIconPath>
    <settlementTexturePath>World/WorldObjects/DefaultSettlement</settlementTexturePath>
    <settlementNameMaker>NamerSettlementTribal</settlementNameMaker>
    <colorSpectrum><li>(0.78,0.16,0.12)</li></colorSpectrum>
    <allowedArrivalTemperatureRange>-25~45</allowedArrivalTemperatureRange>
    <backstoryFilters><li><categories><li>Tribal</li></categories></li></backstoryFilters>
    <apparelStuffFilter>
      <thingDefs><li>Cloth</li><li>WoolSheep</li><li>Leather_Plain</li><li>Leather_Heavy</li><li>Steel</li></thingDefs>
    </apparelStuffFilter>
    <allowedCultures><li>Rustican</li></allowedCultures>
    <requiredMemes>
      <li MayRequire="Ludeon.RimWorld.Ideology">ARIOIAF_Structure_FaithOfTheSeven</li>
      <li MayRequire="Ludeon.RimWorld.Ideology">ARIOIAF_ChivalricHonor</li>
      <li MayRequire="Ludeon.RimWorld.Ideology">ARIOIAF_Feudalism</li>
    </requiredMemes>
    <allowedMemes>
      <li MayRequire="Ludeon.RimWorld.Ideology">ARIOIAF_Structure_FaithOfTheSeven</li>
      <li MayRequire="Ludeon.RimWorld.Ideology">ARIOIAF_ChivalricHonor</li>
      <li MayRequire="Ludeon.RimWorld.Ideology">ARIOIAF_Feudalism</li>
    </allowedMemes>
    <structureMemeWeights><ARIOIAF_Structure_FaithOfTheSeven MayRequire="Ludeon.RimWorld.Ideology">1</ARIOIAF_Structure_FaithOfTheSeven></structureMemeWeights>
    <royalFavorLabel MayRequire="Ludeon.RimWorld.Royalty">honor</royalFavorLabel>
    <royalFavorIconPath MayRequire="Ludeon.RimWorld.Royalty">UI/Icons/RoyalFavor</royalFavorIconPath>
    <royalTitleTags MayRequire="Ludeon.RimWorld.Royalty"><li>ARIOIAF_WesternTitle</li></royalTitleTags>
    <royalTitleInheritanceWorkerClass MayRequire="Ludeon.RimWorld.Royalty">RoyalTitleInheritanceWorker</royalTitleInheritanceWorkerClass>
    <royalTitleInheritanceRelations MayRequire="Ludeon.RimWorld.Royalty"><li>Child</li><li>Grandchild</li><li>Spouse</li><li>Sibling</li><li>Parent</li></royalTitleInheritanceRelations>
    <caravanTraderKinds><li>Caravan_Neolithic_BulkGoods</li><li>Caravan_Neolithic_WarMerchant</li></caravanTraderKinds>
    <visitorTraderKinds><li>Visitor_Neolithic_Standard</li></visitorTraderKinds>
    <baseTraderKinds><li>Base_Neolithic_Standard</li></baseTraderKinds>
    <maxPawnCostPerTotalPointsCurve>
      <points><li>(0,45)</li><li>(150,110)</li><li>(400,150)</li><li>(700,220)</li><li>(2000,10000)</li></points>
    </maxPawnCostPerTotalPointsCurve>
    <pawnGroupMakers>
      <li>
        <kindDef>Combat</kindDef>
        <options><ARIOIAF_Westerlanders_Levy>4</ARIOIAF_Westerlanders_Levy><ARIOIAF_Westerlanders_Bowman>4</ARIOIAF_Westerlanders_Bowman><ARIOIAF_Westerlanders_Footman>6</ARIOIAF_Westerlanders_Footman><ARIOIAF_Westerlanders_Houseguard>2</ARIOIAF_Westerlanders_Houseguard><ARIOIAF_Westerlanders_Officer>1</ARIOIAF_Westerlanders_Officer></options>
      </li>
      <li>
        <kindDef>Peaceful</kindDef>
        <options><ARIOIAF_Westerlanders_Levy>5</ARIOIAF_Westerlanders_Levy><ARIOIAF_Westerlanders_Bowman>3</ARIOIAF_Westerlanders_Bowman><ARIOIAF_Westerlanders_Officer>1</ARIOIAF_Westerlanders_Officer></options>
      </li>
      <li>
        <kindDef>Trader</kindDef>
        <traders><ARIOIAF_Westerlanders_CaravanLeader>1</ARIOIAF_Westerlanders_CaravanLeader></traders>
        <carriers><Muffalo>4</Muffalo><Alpaca>4</Alpaca><Dromedary>2</Dromedary></carriers>
        <guards><ARIOIAF_Westerlanders_Bowman>3</ARIOIAF_Westerlanders_Bowman><ARIOIAF_Westerlanders_Footman>6</ARIOIAF_Westerlanders_Footman><ARIOIAF_Westerlanders_Houseguard>2</ARIOIAF_Westerlanders_Houseguard><ARIOIAF_Westerlanders_Officer>1</ARIOIAF_Westerlanders_Officer></guards>
      </li>
      <li>
        <kindDef>Settlement</kindDef>
        <options><ARIOIAF_Westerlanders_Levy>3</ARIOIAF_Westerlanders_Levy><ARIOIAF_Westerlanders_Bowman>4</ARIOIAF_Westerlanders_Bowman><ARIOIAF_Westerlanders_Footman>6</ARIOIAF_Westerlanders_Footman><ARIOIAF_Westerlanders_Houseguard>3</ARIOIAF_Westerlanders_Houseguard><ARIOIAF_Westerlanders_Officer>1</ARIOIAF_Westerlanders_Officer></options>
      </li>
    </pawnGroupMakers>
  </FactionDef>
</Defs>
