<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <FactionDef ParentName="FactionBase">
    <defName>ARIOIAF_Riverlanders</defName>
    <label>Riverlanders</label>
    <description>Houses of the river crossings, sworn to the Faith of the Seven. Crimson levies, bowmen and scale-armored guards under trout banners. Starts at peace and sends merchant caravans. With Royalty, service earns six ranks from Squire to Lord Paramount.</description>
    <fixedName>Riverlanders</fixedName>
    <pawnSingular>riverlander</pawnSingular>
    <pawnsPlural>riverlanders</pawnsPlural>
    <categoryTag>ARIOIAF_Riverlanders</categoryTag>
    <techLevel>Medieval</techLevel>
    <basicMemberKind>ARIOIAF_Riverlanders_Levy</basicMemberKind>
    <settlementGenerationWeight>1</settlementGenerationWeight>
    <requiredCountAtGameStart>1</requiredCountAtGameStart>
    <maxConfigurableAtWorldCreation>1</maxConfigurableAtWorldCreation>
    <configurationListOrderPriority>76</configurationListOrderPriority>
    <canSiege>false</canSiege>
    <canStageAttacks>true</canStageAttacks>
    <leaderTitle>Lord Paramount</leaderTitle>
    <leaderTitleFemale>Lady Paramount</leaderTitleFemale>
    <leaderForceGenerateNewPawn>true</leaderForceGenerateNewPawn>
    <fixedLeaderKinds><li>ARIOIAF_Riverlanders_LordParamount</li></fixedLeaderKinds>
    <factionIconPath>UI/Factions/Riverlanders</factionIconPath>
    <settlementTexturePath>World/WorldObjects/DefaultSettlement</settlementTexturePath>
    <settlementNameMaker>NamerSettlementTribal</settlementNameMaker>
    <colorSpectrum><li>(0.62,0.20,0.26)</li></colorSpectrum>
    <allowedArrivalTemperatureRange>-25~45</allowedArrivalTemperatureRange>
    <backstoryFilters><li><categories><li>Tribal</li></categories></li></backstoryFilters>
    <apparelStuffFilter>
      <thingDefs><li>Cloth</li><li>WoolSheep</li><li>Leather_Plain</li><li>Leather_Heavy</li><li>Steel</li></thingDefs>
    </apparelStuffFilter>
    <allowedCultures><li>Rustican</li></allowedCultures>
    <requiredMemes>
      <li MayRequire="Ludeon.RimWorld.Ideology">ARIOIAF_Structure_FaithOfTheSeven</li>
      <li MayRequire="Ludeon.RimWorld.Ideology">ARIOIAF_ChivalricHonor</li>
      <li MayRequire="Ludeon.RimWorld.Ideology">ARIOIAF_Feudalism</li>
    </requiredMemes>
    <allowedMemes>
      <li MayRequire="Ludeon.RimWorld.Ideology">ARIOIAF_Structure_FaithOfTheSeven</li>
      <li MayRequire="Ludeon.RimWorld.Ideology">ARIOIAF_ChivalricHonor</li>
      <li MayRequire="Ludeon.RimWorld.Ideology">ARIOIAF_Feudalism</li>
    </allowedMemes>
    <structureMemeWeights><ARIOIAF_Structure_FaithOfTheSeven MayRequire="Ludeon.RimWorld.Ideology">1</ARIOIAF_Structure_FaithOfTheSeven></structureMemeWeights>
    <royalFavorLabel MayRequire="Ludeon.RimWorld.Royalty">honor</royalFavorLabel>
    <royalFavorIconPath MayRequire="Ludeon.RimWorld.Royalty">UI/Icons/RoyalFavor</royalFavorIconPath>
    <royalTitleTags MayRequire="Ludeon.RimWorld.Royalty"><li>ARIOIAF_RiverlanderTitle</li></royalTitleTags>
    <royalTitleInheritanceWorkerClass MayRequire="Ludeon.RimWorld.Royalty">RoyalTitleInheritanceWorker</royalTitleInheritanceWorkerClass>
    <royalTitleInheritanceRelations MayRequire="Ludeon.RimWorld.Royalty"><li>Child</li><li>Grandchild</li><li>Spouse</li><li>Sibling</li><li>Parent</li></royalTitleInheritanceRelations>
    <caravanTraderKinds><li>Caravan_Neolithic_BulkGoods</li><li>Caravan_Neolithic_WarMerchant</li></caravanTraderKinds>
    <visitorTraderKinds><li>Visitor_Neolithic_Standard</li></visitorTraderKinds>
    <baseTraderKinds><li>Base_Neolithic_Standard</li></baseTraderKinds>
    <maxPawnCostPerTotalPointsCurve>
      <points><li>(0,45)</li><li>(150,110)</li><li>(400,150)</li><li>(700,220)</li><li>(2000,10000)</li></points>
    </maxPawnCostPerTotalPointsCurve>
    <pawnGroupMakers>
      <li>
        <kindDef>Combat</kindDef>
        <options><ARIOIAF_Riverlanders_Levy>4</ARIOIAF_Riverlanders_Levy><ARIOIAF_Riverlanders_Bowman>4</ARIOIAF_Riverlanders_Bowman><ARIOIAF_Riverlanders_Footman>6</ARIOIAF_Riverlanders_Footman><ARIOIAF_Riverlanders_Houseguard>2</ARIOIAF_Riverlanders_Houseguard><ARIOIAF_Riverlanders_Officer>1</ARIOIAF_Riverlanders_Officer></options>
      </li>
      <li>
        <kindDef>Peaceful</kindDef>
        <options><ARIOIAF_Riverlanders_Levy>5</ARIOIAF_Riverlanders_Levy><ARIOIAF_Riverlanders_Bowman>3</ARIOIAF_Riverlanders_Bowman><ARIOIAF_Riverlanders_Officer>1</ARIOIAF_Riverlanders_Officer></options>
      </li>
      <li>
        <kindDef>Trader</kindDef>
        <traders><ARIOIAF_Riverlanders_CaravanLeader>1</ARIOIAF_Riverlanders_CaravanLeader></traders>
        <carriers><Muffalo>5</Muffalo><Alpaca>5</Alpaca></carriers>
        <guards><ARIOIAF_Riverlanders_Bowman>4</ARIOIAF_Riverlanders_Bowman><ARIOIAF_Riverlanders_Footman>6</ARIOIAF_Riverlanders_Footman><ARIOIAF_Riverlanders_Houseguard>2</ARIOIAF_Riverlanders_Houseguard><ARIOIAF_Riverlanders_Officer>1</ARIOIAF_Riverlanders_Officer></guards>
      </li>
      <li>
        <kindDef>Settlement</kindDef>
        <options><ARIOIAF_Riverlanders_Levy>3</ARIOIAF_Riverlanders_Levy><ARIOIAF_Riverlanders_Bowman>4</ARIOIAF_Riverlanders_Bowman><ARIOIAF_Riverlanders_Footman>6</ARIOIAF_Riverlanders_Footman><ARIOIAF_Riverlanders_Houseguard>3</ARIOIAF_Riverlanders_Houseguard><ARIOIAF_Riverlanders_Officer>1</ARIOIAF_Riverlanders_Officer></options>
      </li>
    </pawnGroupMakers>
  </FactionDef>
</Defs>
