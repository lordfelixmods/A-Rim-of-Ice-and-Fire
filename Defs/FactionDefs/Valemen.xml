<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <FactionDef ParentName="FactionBase">
    <defName>ARIOIAF_Valemen</defName>
    <label>Valemen</label>
    <description>Mountain houses of the Vale, sworn to the Faith of the Seven and knightly service. Blue-clad levies, disciplined bowmen and armored guards. Starts at peace and sends merchants through the passes. With Royalty, service earns titles from Squire to Warden of the East.</description>
    <fixedName>Valemen</fixedName>
    <pawnSingular>valeman</pawnSingular>
    <pawnsPlural>valemen</pawnsPlural>
    <categoryTag>ARIOIAF_Valemen</categoryTag>
    <techLevel>Medieval</techLevel>
    <basicMemberKind>ARIOIAF_Valemen_Levy</basicMemberKind>
    <settlementGenerationWeight>1</settlementGenerationWeight>
    <requiredCountAtGameStart>1</requiredCountAtGameStart>
    <maxConfigurableAtWorldCreation>1</maxConfigurableAtWorldCreation>
    <configurationListOrderPriority>77</configurationListOrderPriority>
    <canSiege>false</canSiege>
    <canStageAttacks>true</canStageAttacks>
    <leaderTitle>Warden of the East</leaderTitle>
    <leaderForceGenerateNewPawn>true</leaderForceGenerateNewPawn>
    <fixedLeaderKinds><li>ARIOIAF_Valemen_Warden</li></fixedLeaderKinds>
    <factionIconPath>UI/Factions/Valemen</factionIconPath>
    <settlementTexturePath>World/WorldObjects/DefaultSettlement</settlementTexturePath>
    <settlementNameMaker>NamerSettlementTribal</settlementNameMaker>
    <colorSpectrum><li>(0.20,0.40,0.78)</li></colorSpectrum>
    <allowedArrivalTemperatureRange>-35~40</allowedArrivalTemperatureRange>
    <backstoryFilters><li><categories><li>Tribal</li></categories></li></backstoryFilters>
    <apparelStuffFilter>
      <thingDefs><li>Cloth</li><li>WoolSheep</li><li>WoolMuffalo</li><li>Leather_Plain</li><li>Leather_Heavy</li><li>Steel</li></thingDefs>
    </apparelStuffFilter>
    <allowedCultures><li>Rustican</li></allowedCultures>
    <requiredMemes>
      <li MayRequire="Ludeon.RimWorld.Ideology">ARIOIAF_Structure_FaithOfTheSeven</li>
      <li MayRequire="Ludeon.RimWorld.Ideology">ARIOIAF_ChivalricHonor</li>
      <li MayRequire="Ludeon.RimWorld.Ideology">ARIOIAF_Feudalism</li>
    </requiredMemes>
    <allowedMemes>
      <li MayRequire="Ludeon.RimWorld.Ideology">ARIOIAF_Structure_FaithOfTheSeven</li>
      <li MayRequire="Ludeon.RimWorld.Ideology">ARIOIAF_ChivalricHonor</li>
      <li MayRequire="Ludeon.RimWorld.Ideology">ARIOIAF_Feudalism</li>
    </allowedMemes>
    <structureMemeWeights><ARIOIAF_Structure_FaithOfTheSeven MayRequire="Ludeon.RimWorld.Ideology">1</ARIOIAF_Structure_FaithOfTheSeven></structureMemeWeights>
    <royalFavorLabel MayRequire="Ludeon.RimWorld.Royalty">honor</royalFavorLabel>
    <royalFavorIconPath MayRequire="Ludeon.RimWorld.Royalty">UI/Icons/RoyalFavor</royalFavorIconPath>
    <royalTitleTags MayRequire="Ludeon.RimWorld.Royalty"><li>ARIOIAF_EasternTitle</li></royalTitleTags>
    <royalTitleInheritanceWorkerClass MayRequire="Ludeon.RimWorld.Royalty">RoyalTitleInheritanceWorker</royalTitleInheritanceWorkerClass>
    <royalTitleInheritanceRelations MayRequire="Ludeon.RimWorld.Royalty"><li>Child</li><li>Grandchild</li><li>Spouse</li><li>Sibling</li><li>Parent</li></royalTitleInheritanceRelations>
    <caravanTraderKinds><li>Caravan_Neolithic_BulkGoods</li><li>Caravan_Neolithic_WarMerchant</li></caravanTraderKinds>
    <visitorTraderKinds><li>Visitor_Neolithic_Standard</li></visitorTraderKinds>
    <baseTraderKinds><li>Base_Neolithic_Standard</li></baseTraderKinds>
    <maxPawnCostPerTotalPointsCurve>
      <points><li>(0,45)</li><li>(150,110)</li><li>(400,150)</li><li>(700,220)</li><li>(2000,10000)</li></points>
    </maxPawnCostPerTotalPointsCurve>
    <pawnGroupMakers>
      <li>
        <kindDef>Combat</kindDef>
        <options><ARIOIAF_Valemen_Levy>4</ARIOIAF_Valemen_Levy><ARIOIAF_Valemen_Bowman>4</ARIOIAF_Valemen_Bowman><ARIOIAF_Valemen_Footman>6</ARIOIAF_Valemen_Footman><ARIOIAF_Valemen_Houseguard>2</ARIOIAF_Valemen_Houseguard><ARIOIAF_Valemen_Officer>1</ARIOIAF_Valemen_Officer></options>
      </li>
      <li>
        <kindDef>Peaceful</kindDef>
        <options><ARIOIAF_Valemen_Levy>5</ARIOIAF_Valemen_Levy><ARIOIAF_Valemen_Bowman>3</ARIOIAF_Valemen_Bowman><ARIOIAF_Valemen_Officer>1</ARIOIAF_Valemen_Officer></options>
      </li>
      <li>
        <kindDef>Trader</kindDef>
        <traders><ARIOIAF_Valemen_CaravanLeader>1</ARIOIAF_Valemen_CaravanLeader></traders>
        <carriers><Muffalo>5</Muffalo><Alpaca>5</Alpaca></carriers>
        <guards><ARIOIAF_Valemen_Bowman>3</ARIOIAF_Valemen_Bowman><ARIOIAF_Valemen_Footman>6</ARIOIAF_Valemen_Footman><ARIOIAF_Valemen_Houseguard>2</ARIOIAF_Valemen_Houseguard><ARIOIAF_Valemen_Officer>1</ARIOIAF_Valemen_Officer></guards>
      </li>
      <li>
        <kindDef>Settlement</kindDef>
        <options><ARIOIAF_Valemen_Levy>3</ARIOIAF_Valemen_Levy><ARIOIAF_Valemen_Bowman>4</ARIOIAF_Valemen_Bowman><ARIOIAF_Valemen_Footman>6</ARIOIAF_Valemen_Footman><ARIOIAF_Valemen_Houseguard>3</ARIOIAF_Valemen_Houseguard><ARIOIAF_Valemen_Officer>1</ARIOIAF_Valemen_Officer></options>
      </li>
    </pawnGroupMakers>
  </FactionDef>
</Defs>
