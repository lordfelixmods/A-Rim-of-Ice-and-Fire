<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <FactionDef ParentName="FactionBase">
    <defName>ARIOIAF_Stormlanders</defName>
    <label>Stormlanders</label>
    <description>Storm-beaten houses under stag banners, sworn to the Faith of the Seven. Hardy levies, bowmen and sworn guards in muted yellow. Starts at peace. With Royalty, service earns six ranks from Squire to Lord Paramount.</description>
    <fixedName>Stormlanders</fixedName>
    <pawnSingular>stormlander</pawnSingular>
    <pawnsPlural>stormlanders</pawnsPlural>
    <categoryTag>ARIOIAF_Stormlanders</categoryTag>
    <techLevel>Medieval</techLevel>
    <basicMemberKind>ARIOIAF_Stormlanders_Levy</basicMemberKind>
    <settlementGenerationWeight>1</settlementGenerationWeight>
    <requiredCountAtGameStart>1</requiredCountAtGameStart>
    <maxConfigurableAtWorldCreation>1</maxConfigurableAtWorldCreation>
    <configurationListOrderPriority>77</configurationListOrderPriority>
    <canSiege>false</canSiege>
    <canStageAttacks>true</canStageAttacks>
    <leaderTitle>Lord Paramount</leaderTitle>
    <leaderTitleFemale>Lady Paramount</leaderTitleFemale>
    <leaderForceGenerateNewPawn>true</leaderForceGenerateNewPawn>
    <fixedLeaderKinds><li>ARIOIAF_Stormlanders_LordParamount</li></fixedLeaderKinds>
    <factionIconPath>UI/Factions/Stormlanders</factionIconPath>
    <settlementTexturePath>World/WorldObjects/DefaultSettlement</settlementTexturePath>
    <settlementNameMaker>NamerSettlementTribal</settlementNameMaker>
    <colorSpectrum><li>(0.70,0.59,0.24)</li></colorSpectrum>
    <allowedArrivalTemperatureRange>-25~45</allowedArrivalTemperatureRange>
    <backstoryFilters><li><categories><li>Tribal</li></categories></li></backstoryFilters>
    <apparelStuffFilter>
      <thingDefs><li>Cloth</li><li>WoolSheep</li><li>Leather_Plain</li><li>Leather_Heavy</li><li>Steel</li></thingDefs>
    </apparelStuffFilter>
    <allowedCultures><li>Rustican</li></allowedCultures>
    <requiredMemes>
      <li MayRequire="Ludeon.RimWorld.Ideology">ARIOIAF_Structure_FaithOfTheSeven</li>
      <li MayRequire="Ludeon.RimWorld.Ideology">ARIOIAF_ChivalricHonor</li>
      <li MayRequire="Ludeon.RimWorld.Ideology">ARIOIAF_Feudalism</li>
    </requiredMemes>
    <allowedMemes>
      <li MayRequire="Ludeon.RimWorld.Ideology">ARIOIAF_Structure_FaithOfTheSeven</li>
      <li MayRequire="Ludeon.RimWorld.Ideology">ARIOIAF_ChivalricHonor</li>
      <li MayRequire="Ludeon.RimWorld.Ideology">ARIOIAF_Feudalism</li>
    </allowedMemes>
    <structureMemeWeights><ARIOIAF_Structure_FaithOfTheSeven MayRequire="Ludeon.RimWorld.Ideology">1</ARIOIAF_Structure_FaithOfTheSeven></structureMemeWeights>
    <royalFavorLabel MayRequire="Ludeon.RimWorld.Royalty">honor</royalFavorLabel>
    <royalFavorIconPath MayRequire="Ludeon.RimWorld.Royalty">UI/Icons/RoyalFavor</royalFavorIconPath>
    <royalTitleTags MayRequire="Ludeon.RimWorld.Royalty"><li>ARIOIAF_StormlanderTitle</li></royalTitleTags>
    <royalTitleInheritanceWorkerClass MayRequire="Ludeon.RimWorld.Royalty">RoyalTitleInheritanceWorker</royalTitleInheritanceWorkerClass>
    <royalTitleInheritanceRelations MayRequire="Ludeon.RimWorld.Royalty"><li>Child</li><li>Grandchild</li><li>Spouse</li><li>Sibling</li><li>Parent</li></royalTitleInheritanceRelations>
    <caravanTraderKinds><li>Caravan_Neolithic_BulkGoods</li><li>Caravan_Neolithic_WarMerchant</li></caravanTraderKinds>
    <visitorTraderKinds><li>Visitor_Neolithic_Standard</li></visitorTraderKinds>
    <baseTraderKinds><li>Base_Neolithic_Standard</li></baseTraderKinds>
    <maxPawnCostPerTotalPointsCurve>
      <points><li>(0,45)</li><li>(150,90)</li><li>(400,130)</li><li>(700,200)</li><li>(2000,10000)</li></points>
    </maxPawnCostPerTotalPointsCurve>
    <pawnGroupMakers>
      <li>
        <kindDef>Combat</kindDef>
        <options><ARIOIAF_Stormlanders_Levy>4</ARIOIAF_Stormlanders_Levy><ARIOIAF_Stormlanders_Bowman>3</ARIOIAF_Stormlanders_Bowman><ARIOIAF_Stormlanders_Footman>7</ARIOIAF_Stormlanders_Footman><ARIOIAF_Stormlanders_Houseguard>2</ARIOIAF_Stormlanders_Houseguard><ARIOIAF_Stormlanders_Officer>1</ARIOIAF_Stormlanders_Officer></options>
      </li>
      <li>
        <kindDef>Peaceful</kindDef>
        <options><ARIOIAF_Stormlanders_Levy>5</ARIOIAF_Stormlanders_Levy><ARIOIAF_Stormlanders_Bowman>3</ARIOIAF_Stormlanders_Bowman><ARIOIAF_Stormlanders_Officer>1</ARIOIAF_Stormlanders_Officer></options>
      </li>
      <li>
        <kindDef>Trader</kindDef>
        <traders><ARIOIAF_Stormlanders_CaravanLeader>1</ARIOIAF_Stormlanders_CaravanLeader></traders>
        <carriers><Muffalo>5</Muffalo><Alpaca>5</Alpaca></carriers>
        <guards><ARIOIAF_Stormlanders_Bowman>3</ARIOIAF_Stormlanders_Bowman><ARIOIAF_Stormlanders_Footman>7</ARIOIAF_Stormlanders_Footman><ARIOIAF_Stormlanders_Houseguard>2</ARIOIAF_Stormlanders_Houseguard><ARIOIAF_Stormlanders_Officer>1</ARIOIAF_Stormlanders_Officer></guards>
      </li>
      <li>
        <kindDef>Settlement</kindDef>
        <options><ARIOIAF_Stormlanders_Levy>3</ARIOIAF_Stormlanders_Levy><ARIOIAF_Stormlanders_Bowman>3</ARIOIAF_Stormlanders_Bowman><ARIOIAF_Stormlanders_Footman>7</ARIOIAF_Stormlanders_Footman><ARIOIAF_Stormlanders_Houseguard>3</ARIOIAF_Stormlanders_Houseguard><ARIOIAF_Stormlanders_Officer>1</ARIOIAF_Stormlanders_Officer></options>
      </li>
    </pawnGroupMakers>
  </FactionDef>
</Defs>
