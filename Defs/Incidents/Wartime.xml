<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- Every worker here self-gates on an actual war (WarAccess), so these never fire in
       peacetime even though the storyteller is free to roll them. -->

  <IncidentDef>
    <defName>ARIO_BorderSkirmish</defName>
    <label>border skirmish</label>
    <category>ThreatSmall</category>
    <targetTags>
      <li>Map_PlayerHome</li>
    </targetTags>
    <workerClass>ARimOfIceAndFire.IncidentWorker_BorderSkirmish</workerClass>
    <baseChance>1.1</baseChance>
    <minRefireDays>4</minRefireDays>
    <pointsScaleable>true</pointsScaleable>
    <allowedBiomes Inherit="false" />
  </IncidentDef>

