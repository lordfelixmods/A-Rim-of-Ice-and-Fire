<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <ThingDef ParentName="ArmorSmithableBase">
    <defName>ARIOIAF_RiverlandsScaleArmor</defName>
    <label>Riverlands scale armor</label>
    <description>Silver-gray scales protecting the torso and shoulders. Lighter than plate. Cannot be dyed.</description>
    <graphicData>
      <texPath>Things/Pawn/Humanlike/Apparel/RiverlandsScaleArmor/RiverlandsScaleArmor_Male_south</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <ignoreThingDrawColor>true</ignoreThingDrawColor>
    </graphicData>
    <techLevel>Medieval</techLevel>
    <stuffCategories>
      <li>Metallic</li>
    </stuffCategories>
    <costStuffCount>80</costStuffCount>
    <thingCategories>
      <li>ApparelArmor</li>
    </thingCategories>
    <statBases>
      <WorkToMake>14000</WorkToMake>
      <MaxHitPoints>220</MaxHitPoints>
      <Mass>7</Mass>
      <StuffEffectMultiplierArmor>0.7</StuffEffectMultiplierArmor>
      <StuffEffectMultiplierInsulation_Cold>0.4</StuffEffectMultiplierInsulation_Cold>
      <StuffEffectMultiplierInsulation_Heat>0</StuffEffectMultiplierInsulation_Heat>
      <EquipDelay>7</EquipDelay>
    </statBases>
    <equippedStatOffsets>
      <MoveSpeed>-0.2</MoveSpeed>
    </equippedStatOffsets>
    <recipeMaker>
      <unfinishedThingDef>UnfinishedMetallicTechArmor</unfinishedThingDef>
      <researchPrerequisite>PlateArmor</researchPrerequisite>
      <skillRequirements>
        <Crafting>6</Crafting>
      </skillRequirements>
      <displayPriority>243</displayPriority>
    </recipeMaker>
    <apparel>
      <countsAsClothingForNudity>false</countsAsClothingForNudity>
      <bodyPartGroups>
        <li>Torso</li>
        <li>Shoulders</li>
      </bodyPartGroups>
      <wornGraphicPath>Things/Pawn/Humanlike/Apparel/RiverlandsScaleArmor/RiverlandsScaleArmor</wornGraphicPath>
      <useWornGraphicMask>true</useWornGraphicMask>
      <layers>
        <li>ARIOIAF_ScaleArmor</li>
      </layers>
      <drawData>
        <dataNorth>
          <layer>87</layer>
        </dataNorth>
      </drawData>
      <tags>
        <li>ARIOIAF_RiverlandsApparel</li>
      </tags>
      <defaultOutfitTags>
        <li>Soldier</li>
      </defaultOutfitTags>
      <canBeDesiredForIdeo>false</canBeDesiredForIdeo>
    </apparel>
    <comps Inherit="False">
      <li Class="CompProperties_Forbiddable" />
      <li>
        <compClass>CompQuality</compClass>
      </li>
      <li Class="CompProperties_Styleable" />
    </comps>
  </ThingDef>
</Defs>
