<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <ThingDef ParentName="ArmorSmithableBase">
    <defName>ARIOIAF_TargaryenGorget</defName>
    <label>Targaryen gorget</label>
    <description>A dark Targaryen collar and shoulder guard. Worn with torso armor, but not another gorget. Cannot be dyed. Fits all adult body types.</description>
    <graphicData>
      <texPath>Things/Pawn/Humanlike/Apparel/TargaryenGorget/TargaryenGorget_Male_south</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <shaderType>Cutout</shaderType>
      <ignoreThingDrawColor>true</ignoreThingDrawColor>
    </graphicData>
    <techLevel>Medieval</techLevel>
    <!-- Crafting only: never assigned to regional NPCs, levies or traders. -->
    <generateCommonality>0</generateCommonality>
    <generateAllowChance>0</generateAllowChance>
    <stuffCategories><li>Metallic</li></stuffCategories>
    <costStuffCount>30</costStuffCount>
    <thingCategories><li>ARIOIAF_WesterosArmoryCategory</li></thingCategories>
    <statBases>
      <WorkToMake>3000</WorkToMake>
      <MaxHitPoints>150</MaxHitPoints>
      <Mass>1.5</Mass>
      <StuffEffectMultiplierArmor>0.8</StuffEffectMultiplierArmor>
      <StuffEffectMultiplierInsulation_Cold>0.1</StuffEffectMultiplierInsulation_Cold>
      <StuffEffectMultiplierInsulation_Heat>0</StuffEffectMultiplierInsulation_Heat>
      <EquipDelay>2.5</EquipDelay>
    </statBases>
    <recipeMaker>
      <unfinishedThingDef>UnfinishedMetallicTechArmor</unfinishedThingDef>
      <researchPrerequisite>ARIOIAF_WesterosArmory</researchPrerequisite>
      <skillRequirements><Crafting>4</Crafting></skillRequirements>
      <displayPriority>214</displayPriority>
      <recipeUsers Inherit="False"><li>ARIOIAF_WesterosiArmorersBench</li></recipeUsers>
    </recipeMaker>
    <tradeTags Inherit="False" />
    <apparel>
      <countsAsClothingForNudity>false</countsAsClothingForNudity>
      <bodyPartGroups><li>Neck</li><li>Shoulders</li><li>Hands</li></bodyPartGroups>
      <wornGraphicPath>Things/Pawn/Humanlike/Apparel/TargaryenGorget/TargaryenGorget</wornGraphicPath>
      <!-- Black masks preserve every supplied dark diffuse pixel when worn. -->
      <useWornGraphicMask>true</useWornGraphicMask>
      <layers><li>ARIOIAF_Gorget</li></layers>
      <drawData><dataNorth><layer>89</layer></dataNorth></drawData>
      <tags Inherit="False" />
      <canBeGeneratedToSatisfyWarmth>false</canBeGeneratedToSatisfyWarmth>
      <canBeGeneratedToSatisfyVacuumResistance>false</canBeGeneratedToSatisfyVacuumResistance>
      <canBeGeneratedToSatisfyToxicEnvironmentResistance>false</canBeGeneratedToSatisfyToxicEnvironmentResistance>
      <defaultOutfitTags><li>Soldier</li></defaultOutfitTags>
      <canBeDesiredForIdeo>false</canBeDesiredForIdeo>
    </apparel>
    <comps Inherit="False">
      <li Class="CompProperties_Forbiddable" />
      <li><compClass>CompQuality</compClass></li>
      <li Class="CompProperties_Styleable" />
    </comps>
  </ThingDef>
</Defs>
