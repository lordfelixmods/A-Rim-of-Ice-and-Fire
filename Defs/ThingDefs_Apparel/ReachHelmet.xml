<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <ThingDef ParentName="ArmorHelmetMakeableBase">
    <defName>ARIOIAF_ReachHelmet</defName>
    <label>Reach helmet</label>
    <description>An enclosed helm of the Reach in polished silver-gray. Cannot be dyed.</description>
    <graphicData>
      <texPath>Things/Pawn/Humanlike/Apparel/ReachHelmet/ReachHelmet_south</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <ignoreThingDrawColor>true</ignoreThingDrawColor>
    </graphicData>
    <uiIconScale>1.4</uiIconScale>
    <techLevel>Medieval</techLevel>
    <stuffCategories>
      <li>Metallic</li>
    </stuffCategories>
    <costStuffCount>45</costStuffCount>
    <statBases>
      <WorkToMake>4000</WorkToMake>
      <MaxHitPoints>140</MaxHitPoints>
      <Mass>2.5</Mass>
      <StuffEffectMultiplierArmor>0.55</StuffEffectMultiplierArmor>
      <StuffEffectMultiplierInsulation_Cold>0.15</StuffEffectMultiplierInsulation_Cold>
      <StuffEffectMultiplierInsulation_Heat>0</StuffEffectMultiplierInsulation_Heat>
      <EquipDelay>1.5</EquipDelay>
    </statBases>
    <recipeMaker>
      <researchPrerequisite>Smithing</researchPrerequisite>
      <skillRequirements>
        <Crafting>4</Crafting>
      </skillRequirements>
      <recipeUsers>
        <li>ElectricSmithy</li>
        <li>FueledSmithy</li>
      </recipeUsers>
      <displayPriority>207</displayPriority>
    </recipeMaker>
    <apparel>
      <countsAsClothingForNudity>false</countsAsClothingForNudity>
      <bodyPartGroups>
        <li>FullHead</li>
      </bodyPartGroups>
      <wornGraphicPath>Things/Pawn/Humanlike/Apparel/ReachHelmet/ReachHelmet</wornGraphicPath>
      <useWornGraphicMask>true</useWornGraphicMask>
      <layers>
        <li>Overhead</li>
      </layers>
      <tags>
        <li>ARIOIAF_ReachApparel</li>
      </tags>
      <defaultOutfitTags>
        <li>Soldier</li>
      </defaultOutfitTags>
      <canBeDesiredForIdeo>false</canBeDesiredForIdeo>
    </apparel>
    <comps Inherit="False">
      <li Class="CompProperties_Forbiddable" />
      <li>
        <compClass>CompQuality</compClass>
      </li>
      <li Class="CompProperties_Styleable" />
    </comps>
  </ThingDef>
</Defs>
