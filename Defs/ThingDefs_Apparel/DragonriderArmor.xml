<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <ThingDef ParentName="ArmorSmithableBase">
    <defName>ARIOIAF_DragonriderArmor</defName>
    <!-- The sole allowed stuff supplies the 'Valyrian steel' item-name prefix. -->
    <label>dragonrider armor</label>
    <description>Valyrian steel breastplate and scale vest. Exceptional protection without plate's weight. Covers torso and shoulders; goes over a gambeson or scale armor. Cannot be dyed. Does not fit the fat body type.</description>
    <graphicData>
      <texPath>Things/Pawn/Humanlike/Apparel/DragonriderArmor/DragonriderArmor_Male_south</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <ignoreThingDrawColor>true</ignoreThingDrawColor>
    </graphicData>
    <techLevel>Medieval</techLevel>
    <stuffCategories Inherit="False"><li>ARIOIAF_ValyrianSteelOnly</li></stuffCategories>
    <costStuffCount>80</costStuffCount>
    <thingCategories Inherit="False"><li>ARIOIAF_WesterosArmoryCategory</li></thingCategories>
    <statBases>
      <WorkToMake>24000</WorkToMake>
      <MaxHitPoints>260</MaxHitPoints>
      <Mass>6</Mass>
      <StuffEffectMultiplierArmor>0.9</StuffEffectMultiplierArmor>
      <StuffEffectMultiplierInsulation_Cold>0.6</StuffEffectMultiplierInsulation_Cold>
      <StuffEffectMultiplierInsulation_Heat>0</StuffEffectMultiplierInsulation_Heat>
      <EquipDelay>6</EquipDelay>
    </statBases>
    <equippedStatOffsets><MoveSpeed>-0.1</MoveSpeed></equippedStatOffsets>
    <recipeMaker>
      <unfinishedThingDef>UnfinishedMetallicTechArmor</unfinishedThingDef>
      <researchPrerequisite>ARIOIAF_WesterosArmory</researchPrerequisite>
      <skillRequirements><Crafting>8</Crafting></skillRequirements>
      <displayPriority>246</displayPriority>
      <defaultIngredientFilter Inherit="False">
        <thingDefs><li>TLN_ValyrianSteel</li></thingDefs>
      </defaultIngredientFilter>
    </recipeMaker>
    <apparel>
      <countsAsClothingForNudity>false</countsAsClothingForNudity>
      <bodyPartGroups><li>Torso</li><li>Shoulders</li></bodyPartGroups>
      <wornGraphicPath>Things/Pawn/Humanlike/Apparel/DragonriderArmor/DragonriderArmor</wornGraphicPath>
      <useWornGraphicMask>true</useWornGraphicMask>
      <layers><li>Shell</li></layers>
      <tags><li>ARIOIAF_DragonriderArmor</li></tags>
      <defaultOutfitTags><li>Soldier</li></defaultOutfitTags>
      <canBeDesiredForIdeo>false</canBeDesiredForIdeo>
    </apparel>
    <comps Inherit="False">
      <li Class="CompProperties_Forbiddable" />
      <li><compClass>CompQuality</compClass></li>
      <li Class="CompProperties_Styleable" />
    </comps>
  </ThingDef>
</Defs>
