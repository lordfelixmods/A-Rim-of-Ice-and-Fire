<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <ThingDef ParentName="ApparelMakeableBase">
    <defName>ARIOIAF_WesterosGambeson</defName>
    <label>Westeros gambeson</label>
    <description>A thickly quilted coat that cushions blows and warms a soldier beneath their armor. Worn over a tunic, it covers the torso, limbs and feet. Choose plain or checkered House livery to mark its wearer's allegiance.</description>
    <graphicData>
      <texPath>Things/Pawn/Humanlike/Apparel/WesterosGambeson/WesterosGambeson_Male_south</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <comps>
      <li Class="ARimOfIceAndFire.CompProperties_CloakPattern" />
    </comps>
    <recipeMaker>
      <researchPrerequisite>ComplexClothing</researchPrerequisite>
      <skillRequirements>
        <Crafting>4</Crafting>
      </skillRequirements>
      <displayPriority>215</displayPriority>
    </recipeMaker>
    <techLevel>Medieval</techLevel>
    <costStuffCount>100</costStuffCount>
    <stuffCategories>
      <li>Fabric</li>
      <li>Leathery</li>
    </stuffCategories>
    <thingCategories>
      <li>ApparelMisc</li>
    </thingCategories>
    <statBases>
      <MaxHitPoints>150</MaxHitPoints>
      <WorkToMake>6000</WorkToMake>
      <Mass>3</Mass>
      <ArmorRating_Sharp>0.25</ArmorRating_Sharp>
      <ArmorRating_Blunt>0.36</ArmorRating_Blunt>
      <ArmorRating_Heat>0.1</ArmorRating_Heat>
      <StuffEffectMultiplierArmor>1</StuffEffectMultiplierArmor>
      <StuffEffectMultiplierInsulation_Cold>0.4</StuffEffectMultiplierInsulation_Cold>
      <StuffEffectMultiplierInsulation_Heat>0.1</StuffEffectMultiplierInsulation_Heat>
      <EquipDelay>4</EquipDelay>
    </statBases>
    <apparel>
      <bodyPartGroups>
        <li>Neck</li>
        <li>Torso</li>
        <li>Shoulders</li>
        <li>Arms</li>
        <li>Legs</li>
        <li>Feet</li>
      </bodyPartGroups>
      <wornGraphicPath>Things/Pawn/Humanlike/Apparel/WesterosGambeson/WesterosGambeson</wornGraphicPath>
      <layers>
        <li>Middle</li>
      </layers>
      <tags>
        <li>ARIOIAF_WesterosMilitaryApparel</li>
      </tags>
      <defaultOutfitTags>
        <li>Soldier</li>
      </defaultOutfitTags>
      <canBeDesiredForIdeo>false</canBeDesiredForIdeo>
    </apparel>
  </ThingDef>
</Defs>
