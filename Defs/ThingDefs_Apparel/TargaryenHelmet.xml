<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <ThingDef ParentName="ArmorHelmetMakeableBase">
    <defName>ARIOIAF_TargaryenHelmet</defName>
    <label>Targaryen helmet</label>
    <description>An enclosed blackened Targaryen helm protecting the head and face. Cannot be dyed.</description>
    <graphicData>
      <texPath>Things/Pawn/Humanlike/Apparel/TargaryenHelmet/TargaryenHelmet_south</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <shaderType>Cutout</shaderType>
      <ignoreThingDrawColor>true</ignoreThingDrawColor>
    </graphicData>
    <uiIconScale>1.4</uiIconScale>
    <techLevel>Medieval</techLevel>
    <!-- Crafting only: not issued to Targaryen/Valyrian NPCs or enrolled in traders. -->
    <generateCommonality>0</generateCommonality>
    <generateAllowChance>0</generateAllowChance>
    <stuffCategories><li>Metallic</li></stuffCategories>
    <costStuffCount>45</costStuffCount>
    <thingCategories><li>ARIOIAF_WesterosArmoryCategory</li></thingCategories>
    <statBases>
      <WorkToMake>4000</WorkToMake>
      <MaxHitPoints>140</MaxHitPoints>
      <Mass>2.5</Mass>
      <StuffEffectMultiplierArmor>0.55</StuffEffectMultiplierArmor>
      <StuffEffectMultiplierInsulation_Cold>0.15</StuffEffectMultiplierInsulation_Cold>
      <StuffEffectMultiplierInsulation_Heat>0</StuffEffectMultiplierInsulation_Heat>
      <EquipDelay>1.5</EquipDelay>
    </statBases>
    <recipeMaker>
      <unfinishedThingDef>UnfinishedMetallicTechArmor</unfinishedThingDef>
      <researchPrerequisite>ARIOIAF_WesterosArmory</researchPrerequisite>
      <skillRequirements><Crafting>4</Crafting></skillRequirements>
      <recipeUsers Inherit="False"><li>ARIOIAF_WesterosiArmorersBench</li></recipeUsers>
      <displayPriority>207</displayPriority>
    </recipeMaker>
    <tradeTags Inherit="False" />
    <apparel>
      <countsAsClothingForNudity>false</countsAsClothingForNudity>
      <bodyPartGroups><li>FullHead</li></bodyPartGroups>
      <wornGraphicPath>Things/Pawn/Humanlike/Apparel/TargaryenHelmet/TargaryenHelmet</wornGraphicPath>
      <useWornGraphicMask>true</useWornGraphicMask>
      <layers><li>Overhead</li></layers>
      <tags Inherit="False" />
      <canBeGeneratedToSatisfyWarmth>false</canBeGeneratedToSatisfyWarmth>
      <canBeGeneratedToSatisfyVacuumResistance>false</canBeGeneratedToSatisfyVacuumResistance>
      <canBeGeneratedToSatisfyToxicEnvironmentResistance>false</canBeGeneratedToSatisfyToxicEnvironmentResistance>
      <defaultOutfitTags><li>Soldier</li></defaultOutfitTags>
      <canBeDesiredForIdeo>false</canBeDesiredForIdeo>
    </apparel>
    <comps Inherit="False">
      <li Class="CompProperties_Forbiddable" />
      <li><compClass>CompQuality</compClass></li>
      <li Class="CompProperties_Styleable" />
    </comps>
  </ThingDef>
</Defs>
