<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <ThingDef ParentName="ArmorSmithableBase">
    <defName>ARIOIAF_DragonriderGorget</defName>
    <!-- The sole allowed stuff supplies the 'Valyrian steel' item-name prefix. -->
    <label>dragonrider gorget</label>
    <description>Valyrian steel gorget and shoulder guards. Exceptional protection for very little weight. Cannot be dyed.</description>
    <graphicData>
      <texPath>Things/Pawn/Humanlike/Apparel/DragonriderGorget/DragonriderGorget_Male_south</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <ignoreThingDrawColor>true</ignoreThingDrawColor>
    </graphicData>
    <techLevel>Medieval</techLevel>
    <stuffCategories Inherit="False"><li>ARIOIAF_ValyrianSteelOnly</li></stuffCategories>
    <costStuffCount>30</costStuffCount>
    <thingCategories Inherit="False"><li>ARIOIAF_WesterosArmoryCategory</li></thingCategories>
    <statBases>
      <WorkToMake>3000</WorkToMake>
      <MaxHitPoints>150</MaxHitPoints>
      <Mass>1.5</Mass>
      <StuffEffectMultiplierArmor>0.8</StuffEffectMultiplierArmor>
      <StuffEffectMultiplierInsulation_Cold>0.1</StuffEffectMultiplierInsulation_Cold>
      <StuffEffectMultiplierInsulation_Heat>0</StuffEffectMultiplierInsulation_Heat>
      <EquipDelay>2.5</EquipDelay>
    </statBases>
    <recipeMaker>
      <unfinishedThingDef>UnfinishedMetallicTechArmor</unfinishedThingDef>
      <researchPrerequisite>ARIOIAF_WesterosArmory</researchPrerequisite>
      <skillRequirements><Crafting>8</Crafting></skillRequirements>
      <displayPriority>247</displayPriority>
      <defaultIngredientFilter Inherit="False">
        <thingDefs><li>TLN_ValyrianSteel</li></thingDefs>
      </defaultIngredientFilter>
    </recipeMaker>
    <apparel>
      <countsAsClothingForNudity>false</countsAsClothingForNudity>
      <bodyPartGroups><li>Neck</li><li>Shoulders</li><li>Hands</li></bodyPartGroups>
      <wornGraphicPath>Things/Pawn/Humanlike/Apparel/DragonriderGorget/DragonriderGorget</wornGraphicPath>
      <useWornGraphicMask>true</useWornGraphicMask>
      <layers><li>ARIOIAF_Gorget</li></layers>
      <drawData><dataNorth><layer>89</layer></dataNorth></drawData>
      <tags><li>ARIOIAF_DragonriderGorget</li></tags>
      <defaultOutfitTags><li>Soldier</li></defaultOutfitTags>
      <canBeDesiredForIdeo>false</canBeDesiredForIdeo>
    </apparel>
    <comps Inherit="False">
      <li Class="CompProperties_Forbiddable" />
      <li><compClass>CompQuality</compClass></li>
      <li Class="CompProperties_Styleable" />
    </comps>
  </ThingDef>
</Defs>
