<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!-- Private Industrialised Westeros pool; never replace a vanilla or provider musket. -->
  <ThingDef ParentName="BaseHumanMakeableGun">
    <defName>ARIOIAF_Musket</defName>
    <label>musket</label>
    <description>A long, smoothbore flintlock musket with a hardwood stock and an iron barrel. Its heavy ball is effective at moderate range, but loading powder and shot between volleys is slow.</description>
    <graphicData>
      <texPath>Things/Item/Equipment/WeaponRanged/ARIO/Musket</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(1.4,1.4)</drawSize>
    </graphicData>
    <uiIconScale>0.8</uiIconScale>
    <soundInteract>Interact_Rifle</soundInteract>
    <weaponClasses><li>LongShots</li></weaponClasses>
    <weaponTags Inherit="False"><li>ARIO_IndustrialWesteros</li></weaponTags>
    <tradeTags Inherit="False" />
    <generateAllowChance>1</generateAllowChance>
    <statBases>
      <WorkToMake>9000</WorkToMake>
      <Mass>4.2</Mass>
      <AccuracyTouch>0.65</AccuracyTouch>
      <AccuracyShort>0.75</AccuracyShort>
      <AccuracyMedium>0.60</AccuracyMedium>
      <AccuracyLong>0.35</AccuracyLong>
      <!-- In vanilla, the long cooldown represents muzzle-loading between shots. -->
      <RangedWeapon_Cooldown>5</RangedWeapon_Cooldown>
    </statBases>
    <costList><Steel>45</Steel><WoodLog>30</WoodLog><ComponentIndustrial>1</ComponentIndustrial></costList>
    <recipeMaker>
      <recipeUsers Inherit="False"><li>ARIOIAF_WesterosiArmorersBench</li></recipeUsers>
      <researchPrerequisite>Gunsmithing</researchPrerequisite>
      <researchPrerequisites Inherit="False"><li>ARIOIAF_WesterosArmory</li></researchPrerequisites>
      <skillRequirements><Crafting>4</Crafting></skillRequirements>
      <displayPriority>410</displayPriority>
    </recipeMaker>
    <verbs>
      <li>
        <verbClass>Verb_Shoot</verbClass>
        <hasStandardCommand>true</hasStandardCommand>
        <defaultProjectile>ARIOIAF_Bullet_Musket</defaultProjectile>
        <warmupTime>1.8</warmupTime>
        <range>29.9</range>
        <soundCast>Shot_BoltActionRifle</soundCast>
        <soundCastTail>GunTail_Heavy</soundCastTail>
        <muzzleFlashScale>12</muzzleFlashScale>
      </li>
    </verbs>
    <tools>
      <li><label>stock</label><capacities><li>Blunt</li></capacities><power>9</power><cooldownTime>2</cooldownTime></li>
      <li><label>barrel</label><capacities><li>Blunt</li><li>Poke</li></capacities><power>9</power><cooldownTime>2</cooldownTime></li>
    </tools>
  </ThingDef>
  <ThingDef ParentName="BaseBullet">
    <defName>ARIOIAF_Bullet_Musket</defName>
    <label>musket ball</label>
    <graphicData><texPath>Things/Projectile/Bullet_big</texPath><graphicClass>Graphic_Single</graphicClass></graphicData>
    <projectile>
      <damageDef>Bullet</damageDef>
      <damageAmountBase>20</damageAmountBase>
      <armorPenetrationBase>0.15</armorPenetrationBase>
      <stoppingPower>1.5</stoppingPower>
      <speed>55</speed>
    </projectile>
  </ThingDef>
</Defs>
