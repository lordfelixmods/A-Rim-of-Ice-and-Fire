<?xml version="1.0" encoding="utf-8"?>
<loadFolders>
  <!-- Root keeps the original binaries as a baseline. Same-path overrides select the
       net472 UI for 1.6 and the net10 UI/adapted Core for 1.7, never both builds.
       Common holds content (Defs/Patches/Languages/Textures) shared by both versions;
       it has no Assemblies folder, so no version's DLLs can leak into the other. -->
  <v1.6>
    <li>/</li>
    <li>1.6</li>
    <li>Common</li>
    <li IfModActive="EvilEyeGuy.CustomBaseFramework">Common/Integrations/CustomBaseFramework</li>
    <li IfModActiveAll="EvilEyeGuy.CustomBaseFramework,DankPyon.Medieval.Overhaul">Common/Integrations/CustomBaseFrameworkMO</li>
    <li IfModActiveAll="EvilEyeGuy.CustomBaseFramework,OskarPotocki.VFE.Medieval2">Common/Integrations/CustomBaseFrameworkVFEM2</li>
    <li IfModActive="CETeam.CombatExtended">Common/Integrations/CombatExtended</li>
    <li IfModNotActive="lordfelix.TheLongNight">StandaloneValyrian</li>
    <li IfModActive="Ludeon.RimWorld.Biotech">Biotech</li>
    <li IfModActive="Ludeon.RimWorld.Ideology">Ideology</li>
    <li IfModActive="Ludeon.RimWorld.Royalty">Royalty</li>
    <li IfModActive="CETeam.CombatExtended">ModPatches/ARimOfIceAndFireCore</li>
    <li IfModActive="Mlie.ShowMeYourHands">ModPatches/ShowMeYourHands</li>
    <li IfModActive="astryl.Flourish">ModPatches/Flourish</li>
  </v1.6>
  <v1.7>
    <li>/</li>
    <li>1.7</li>
    <li>Common</li>
    <li IfModActive="EvilEyeGuy.CustomBaseFramework">Common/Integrations/CustomBaseFramework</li>
    <li IfModActiveAll="EvilEyeGuy.CustomBaseFramework,DankPyon.Medieval.Overhaul">Common/Integrations/CustomBaseFrameworkMO</li>
    <li IfModActiveAll="EvilEyeGuy.CustomBaseFramework,OskarPotocki.VFE.Medieval2">Common/Integrations/CustomBaseFrameworkVFEM2</li>
    <li IfModActive="CETeam.CombatExtended">Common/Integrations/CombatExtended</li>
    <li IfModNotActive="lordfelix.TheLongNight">StandaloneValyrian</li>
    <li IfModActive="Ludeon.RimWorld.Biotech">Biotech</li>
    <li IfModActive="Ludeon.RimWorld.Ideology">Ideology</li>
    <li IfModActive="Ludeon.RimWorld.Royalty">Royalty</li>
    <li IfModActive="CETeam.CombatExtended">ModPatches/ARimOfIceAndFireCore</li>
    <li IfModActive="Mlie.ShowMeYourHands">ModPatches/ShowMeYourHands</li>
    <li IfModActive="astryl.Flourish">ModPatches/Flourish</li>
  </v1.7>
</loadFolders>
